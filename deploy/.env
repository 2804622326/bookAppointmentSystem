# AWS ECS 部署环境配置

# AWS 配置
AWS_REGION=eu-west-1
AWS_ACCOUNT_ID=614441038924

# ECR 配置
ECR_REGISTRY=614441038924.dkr.ecr.eu-west-1.amazonaws.com
FRONTEND_REPO_NAME=pet-care-frontend
BACKEND_REPO_NAME=pet-care-backend

# ECS 配置
ECS_CLUSTER_NAME=pet-care-cluster
FRONTEND_SERVICE_NAME=pet-care-frontend-service
BACKEND_SERVICE_NAME=pet-care-backend-service

# 应用配置
DOMAIN_NAME=your-domain.com
API_DOMAIN=api.your-domain.com

# 数据库配置
DB_NAME=petcaresystem
DB_USERNAME=admin
# DB_PASSWORD 应该通过 AWS Secrets Manager 管理

# 镜像标签（用于版本管理）
IMAGE_TAG=latest

# CloudFormation 堆栈名称
STACK_NAME=pet-care-infrastructure